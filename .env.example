# คัดลอกไฟล์นี้เป็น .env แล้วปรับค่าตามจริง
PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string
# ตัวเลือก: กำหนดคีย์เข้ารหัสเอง (base64, 32 bytes) — ถ้าไม่กำหนด ระบบจะสร้างให้อัตโนมัติ
# และเก็บไว้ที่ data/.encryption_key (ห้าม commit ไฟล์นี้ขึ้น git)
# ENCRYPTION_KEY=

# รหัสผ่านเริ่มต้นตอน seed (เปลี่ยนได้ก่อนรัน npm run seed ครั้งแรก)
SEED_ADMIN_PASSWORD=admin1234
SEED_STAFF_PASSWORD=staff1234

# ===== เชื่อมต่อ Google Sheets เป็นฐานข้อมูล (ตัวเลือก) =====
# ถ้าไม่ตั้งค่าอะไรในหมวดนี้เลย ระบบจะใช้ไฟล์ JSON local (data/) ตามเดิมโดยอัตโนมัติ
# วิธีตั้งค่าแบบละเอียดดู README หัวข้อ "เชื่อมต่อ Google Sheets"

# 1) รหัส Spreadsheet (ตัดมาจาก URL ของ Google Sheet ที่สร้างไว้)
#    https://docs.google.com/spreadsheets/d/<SHEET_ID_ตรงนี้>/edit
# GOOGLE_SHEET_ID=

# 2) ข้อมูล Service Account (สร้างจาก Google Cloud Console แล้วแชร์ชีตให้อีเมลนี้เป็น Editor)
#    เลือกใช้วิธีใดวิธีหนึ่ง:
#    วิธี A — แยก 2 ค่า (คัดลอกจากไฟล์ JSON ที่ดาวน์โหลดมา)
# GOOGLE_SERVICE_ACCOUNT_EMAIL=xxx@xxx.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n....\n-----END PRIVATE KEY-----\n"
#    วิธี B — วางเนื้อหาไฟล์ JSON ทั้งไฟล์เป็นบรรทัดเดียว (สะดวกกว่าบนบางแพลตฟอร์ม deploy)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...","private_key":"...","...":"..."}

# 3) บังคับเลือกฐานข้อมูล ("local" หรือ "sheets") — ปกติไม่ต้องตั้ง ระบบตรวจให้อัตโนมัติ
#    จาก GOOGLE_SHEET_ID ด้านบน ตั้งเฉพาะตอนต้องการ override เช่นทดสอบโหมด local
#    ทั้งที่มี GOOGLE_SHEET_ID อยู่ใน .env ด้วย
# STORAGE_BACKEND=
